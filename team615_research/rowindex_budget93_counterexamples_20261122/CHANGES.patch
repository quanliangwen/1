+@dataclass
+class BudgetSubmission:
+    """Independent bounded exit; unknown peer stock is never confirmed empty."""
+    START_PERCENT = 93
+    FRESH_STOCK_STEPS = DeadlineSubmission.BACKUP_INTERVAL
+    score: int | None = None
+    last_gate: tuple | None = None
+
+    @classmethod
+    def window(cls, limit):
+        start = (limit * cls.START_PERCENT + 99) // 100
+        return start, start + DeadlineSubmission.WINDOW - 1
+
+    @classmethod
+    def active(cls, step, limit):
+        start, end = cls.window(limit)
+        # Do not move the real final window or its navigation consumers.
+        return start <= step <= end < DeadlineSubmission.window_start(limit)
+
+    @classmethod
+    def stock_status(cls, step, owner, team_size, records):
+        unknown, carrying = [], []
+        for peer in range(team_size):
+            if peer == owner:
+                continue
+            record = records.get(peer)
+            if record is None:
+                unknown.append(peer)
+                continue
+            stamp, count = record
+            if not 0 <= stamp <= step or count < 0:
+                unknown.append(peer)
+            elif count > 0:
+                if step - stamp <= cls.FRESH_STOCK_STEPS:
+                    carrying.append(peer)
+                else:
+                    unknown.append(peer)
+        return tuple(unknown), tuple(carrying)
+
+    @classmethod
+    def peer_ranks(cls, step, limit, bids):
+        return DeadlineSubmission.peer_ranks(step, cls.window(limit)[1], bids)
+
+    @classmethod
+    def submit_due(cls, step, limit, own, bids):
+        return (cls.active(step, limit)
+                and DeadlineSubmission.submit_due(step, cls.window(limit)[1], own, bids))
