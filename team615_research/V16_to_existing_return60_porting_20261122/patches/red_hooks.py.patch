+    def _budget_submission_candidate(self):
+        # Read cached bytes only. No scan, fusion, fitting or forced refresh.
+        deadline = self.deadline_submission
+        candidates = [(self.group_best_image, 'group_cache')]
+        if deadline.backup_image is not None:
+            candidates.append(((deadline.backup_image, None, {}), 'backup_cache'))
+        if deadline.image is not None:
+            candidates.append(((deadline.image, deadline.cache, self.deadline_versions), 'deadline_cache'))
+        for candidate, source in candidates:
+            if candidate is not None and candidate[0] is not None and candidate[0].any():
+                return candidate, source
+        return None, None
+
+    def _budget_submission_gate(self, step):
+        budget = self.budget_submission
+        if not budget.active(step, self.limit):
+            return 'outside_window', (), ()
+        if (self.previous_inventory != 0 or self.pending_drop is not None
+                or int(self.carried_bombs_count()) != 0):
+            return 'local_stock_or_pending', (), ()
+        unknown, carrying = budget.stock_status(
+            step, int(self.identifier), self.team_size, self.inventory_records)
+        if carrying:
+            return 'fresh_peer_stock', unknown, carrying
+        if self.map_quality is None:
+            return 'no_estimate', unknown, ()
+        if self._budget_submission_candidate()[0] is None:
+            return 'no_cached_image', unknown, ()
+        return None, unknown, ()
+
+    def _try_budget_submission(self, step):
+        budget = self.budget_submission
+        if not budget.active(step, self.limit):
+            return False
+        reason, unknown, carrying = self._budget_submission_gate(step)
+        gate = reason, unknown, carrying
+        if gate != budget.last_gate:
+            self.budget_submission_audit.append((step, 'gate', reason, unknown, carrying))
+            budget.last_gate = gate
+        if reason is not None:
+            return False
+        if budget.score is None:
+            budget.score = self.final_maps.rank(self.map_quality)
+        own = budget.score, -int(self.identifier)
+        peers = budget.peer_ranks(step, self.limit, self.map_bids)
+        if not budget.submit_due(step, self.limit, own, peers):
+            return False
+        (image, cache, versions), source = self._budget_submission_candidate()
+        self.submit_exploration_map(image.astype(np.uint8, copy=False))
+        self.submitted_cache = cache
+        self.final_submission_versions = dict(versions)
+        self.submission_elected_rank = budget.score
+        self.red_submission_step = step
+        self.submitted = True
+        self.budget_submission_event = dict(
+            step=step, reason='step_budget', window=budget.window(self.limit),
+            local_inventory=self.previous_inventory, team_confirmed=self._all_inventory_empty(),
+            unconfirmed_peers=unknown, inventory_records=dict(self.inventory_records),
+            image_source=source, in_window_peer_estimates={-peer: score for score, peer in peers})
+        return True
