     def can_finish(self, drone, step):
         # Absolute existing 180+24-step allowance; no per-message timer.
         return (step>=self.finish_floor(drone)
+                or self.early_finish_started is not None
+                and step>=self.early_finish_started+FinalMaps.COLLECTION_STEPS
+                and self._confirmed_empty(drone,step,range(self.team_size))
+                and drone.previous_inventory==0 and drone.pending_drop is None
+                and drone.carried_bombs_count()==0
                 or drone.walltime_limit-drone.elapsed_walltime<PreSubmitScan.MIN_WALLTIME_LEFT)
+
+    @staticmethod
+    def _confirmed_empty(drone, step, owners):
+        return all(owner in drone.inventory_records
+                   and 0<=drone.inventory_records[owner][0]<=step
+                   and drone.inventory_records[owner][1]==0 for owner in owners)
+
+    def _exchange_acked(self, drone, step, owners, *, all_zero=False):
+        owners=set(owners)
+        if not self.complete(owners):return False
+        if not self._confirmed_empty(drone,step,owners):return False
+        if len(owners)==1 and not all_zero:return True
+        required=set(range(self.team_size)) if all_zero else owners
+        for peer,p in self.fresh(step).items():
+            if peer==self.owner or peer not in owners:continue
+            stamp,zeros=self.peer_zero_receipts.get(peer,(-100,frozenset()))
+            if not 0<=step-stamp<=12 or not required.issubset(zeros):continue
+            wanted={(kind,owner,item['version'],item['digest'])
+                    for kind,store in [('snapshot',self.candidates.snapshots),('image',self.candidates.images)]
+                    for owner,item in store.items() if owner in owners}
+            if wanted.issubset(p['have']):return True
+        return False
+
+    def exchange_finish_ready(self, drone, step):
+        if (step<self.start() or drone.previous_inventory!=0 or drone.pending_drop is not None
+                or drone.carried_bombs_count()!=0
+                or not self._confirmed_empty(drone,step,range(self.team_size))):return False
+        if self.early_finish_started is not None:return True
+        if self.candidates.best is None or drone.group_best_image is None:return False
+        if not drone.group_best_image[0].any():return False
+        # Require an actual two-way exchange, not a phase label, a manifest
+        # alone, or all five maps. Immutable payload receipts remain usable.
+        for peer in self.fresh(step):
+            if self._exchange_acked(drone,step,{self.owner,peer},all_zero=True):
+                self.early_finish_started=step
+                self.audit.append((step,'exchange_finish_ready',peer,FinalMaps.COLLECTION_STEPS))
+                return True
+        return False
 
