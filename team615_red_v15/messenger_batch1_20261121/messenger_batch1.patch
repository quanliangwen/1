+    def receive(self, drone, message, step):
+        """Record only a fresh message originating from the named peer."""
+        sender = message.get("id")
+        if (type(sender) is not int or sender == drone.identifier
+                or not 0 <= sender < drone.team_size):
+            return
+        own_state = next((state for state in message.get("states", ())
+                          if isinstance(state, dict) and state.get("id") == sender), None)
+        stamp = None if own_state is None else own_state.get("step")
+        previous = self.receipts.get(sender)
+        if (type(stamp) is not int or not 0 <= step - stamp <= self.DIRECT_TTL
+                or previous is not None and stamp <= previous["sent_step"]):
+            return
+        seen = {}
+        for owner, version in message.get("red_map_seen", {}).items():
+            if (type(owner) is int and 0 <= owner < drone.team_size
+                    and type(version) is int and 0 <= version <= stamp):
+                seen[owner] = version
+        empty = set()
+        for owner, record in message.get("red_inventory", {}).items():
+            if (type(owner) is int and 0 <= owner < drone.team_size
+                    and isinstance(record, (tuple, list)) and len(record) == 2
+                    and type(record[0]) is int and 0 <= record[0] <= stamp and record[1] == 0):
+                empty.add(owner)
+        packet = message.get("red_map")
+        version = None
+        if (isinstance(packet, tuple) and len(packet) == 2
+                and type(packet[0]) is int and 0 <= packet[0] <= stamp
+                and drone.map_revision.get(sender, -1) >= packet[0]):
+            version = packet[0]
+        self.receipts[sender] = dict(sent_step=stamp, received_step=step,
+                                     seen=seen, empty=empty, map_version=version)
 
