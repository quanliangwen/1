+
+        # Dedicated messenger: once active it owns navigation so the ordinary
+        # exploration/placement branches cannot override its tour.
+        if self.group_exchange is not None:
+            intent = self.group_exchange.prepare_return(self, step)
+            if intent is not None:
+                self.group_exchange.commit_return(self, intent, step)
+            if self.group_exchange.candidates.snapshots and self.group_exchange.try_submit(self, step, local_score):
+                return command
+        if (not (self.group_exchange is not None and self.group_exchange.owns_navigation)
+                and self.messenger.tick(self, step, command, steps_left)):
+            return command
+
+        ranges = self.lidar_values()
+        semantic = self.semantic_values() or ()
+        if ranges is not None and step % 4 == 0:
