+def _live_prefix_open(pose, point, hits):
+    delta = np.asarray(point, dtype=float) - pose
+    length = np.linalg.norm(delta)
+    if length <= 1e-6:
+        return True
+    axis = delta / length
+    along = hits @ axis
+    side = np.abs(hits[:, 0] * axis[1] - hits[:, 1] * axis[0])
+    return not np.any((along > 0.) & (along < 26.) & (side < 23.))
